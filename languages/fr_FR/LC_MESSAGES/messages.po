msgid "Social Media Previewer"
msgstr "Aperçu des réseaux sociaux"

msgid "Previews the current page for X, Telegram, Facebook, Nostr, LinkedIn, Bluesky and Mastodon before publishing."
msgstr "Affiche avant publication un aperçu de la page actuelle pour X, Telegram, Facebook, Nostr, LinkedIn, Bluesky et Mastodon."

msgid "Social Media Preview"
msgstr "Aperçu des réseaux sociaux"

msgid "Preview this page for social media"
msgstr "Prévisualiser cette page pour les réseaux sociaux"

msgid "Social media preview"
msgstr "Aperçu des réseaux sociaux"

msgid "Close"
msgstr "Fermer"


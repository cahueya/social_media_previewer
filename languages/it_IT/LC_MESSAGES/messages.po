msgid "Social Media Previewer"
msgstr "Anteprima social media"

msgid "Previews the current page for X, Telegram, Facebook, Nostr, LinkedIn, Bluesky and Mastodon before publishing."
msgstr "Mostra prima della pubblicazione un’anteprima della pagina corrente per X, Telegram, Facebook, Nostr, LinkedIn, Bluesky e Mastodon."

msgid "Social Media Preview"
msgstr "Anteprima social media"

msgid "Preview this page for social media"
msgstr "Mostra l’anteprima di questa pagina per i social media"

msgid "Social media preview"
msgstr "Anteprima social media"

msgid "Close"
msgstr "Chiudi"

msgid "Previous platform"
msgstr "Piattaforma precedente"

msgid "Next platform"
msgstr "Piattaforma successiva"

msgid "Platforms"
msgstr "Piattaforme"

msgid "Check required"
msgstr "Verifica necessaria"

msgid "No problems found"
msgstr "Nessun problema rilevato"


msgid "Social Media Previewer"
msgstr "Social-Media-Vorschau"

msgid "Previews the current page for X, Telegram, Facebook, Nostr, LinkedIn, Bluesky and Mastodon before publishing."
msgstr "Zeigt vor der Veröffentlichung eine Vorschau der aktuellen Seite für X, Telegram, Facebook, Nostr, LinkedIn, Bluesky und Mastodon."

msgid "Social Media Preview"
msgstr "Social-Media-Vorschau"

msgid "Preview this page for social media"
msgstr "Diese Seite für soziale Medien in der Vorschau anzeigen"

msgid "Social media preview"
msgstr "Social-Media-Vorschau"

msgid "Close"
msgstr "Schließen"

msgid "Previous platform"
msgstr "Vorherige Plattform"

msgid "Next platform"
msgstr "Nächste Plattform"

msgid "Platforms"
msgstr "Plattformen"

msgid "Check required"
msgstr "Prüfung erforderlich"

